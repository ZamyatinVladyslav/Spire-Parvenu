[sub_resource type="GDScript" id="GDScript_au3t3"]
script/source = "extends Node2D

# Убираем @onready для прямой записи, либо оставляем для обновления
@onready var name_label = $BaseCard/CardName/NameLbl
@onready var description_label = $BaseCard/CardDescription

var card_data: CardData # Сюда сохраним данные

func setup(data: CardData):
	card_data = data # Просто сохраняем ссылку на ресурс
	# Если узел уже в дереве (например, при переиспользовании), обновляем
	if is_node_ready():
		_apply_data()

func _ready():
	# Когда все дочерние узлы созданы, применяем текст
	_apply_data()

func _apply_data():
	if card_data:
		name_label.text = card_data.card_name
		description_label.text = card_data.card_description
"

