resource_name = "HandManager"
script/source = "extends Node


@export var card_scene: PackedScene
@onready var hand_container = $\"../UI/PlayerHand\"

@export var character_node: Character

var dragged_card_node: Node2D 
var dragged_card_data: CardData 
var is_dragging: bool = false
var original_card_position: Vector2

var all_cards: Array[CardData] = []

var draw_pile: Array[CardData] = []
var hand_pile: Array[CardData] = []
var discard_pile: Array[CardData] = []

var action_queue: Array[Dictionary] = []
const MAX_QUEUE_SIZE: int = 3

func _ready():
	randomize()
	
	if character_node and character_node.character_data:
		# Копируем стартовую колоду ИМЕННО ЭТОГО персонажа
		all_cards = character_node.character_data.starting_deck.duplicate()
		print(\"Loaded deck: \", character_node.character_data.name, \". Cards: \", all_cards.size())
	else:
		push_error(\"Err: Character not found\")
	
	start_battle()

func start_battle():
	draw_pile.clear()
	hand_pile.clear()
	discard_pile.clear()
	
	draw_pile = all_cards.duplicate()
	draw_pile.shuffle()
	
	draw_cards(5)

func draw_cards(count: int):
	print(\"Info: Cards in draw pile - \", draw_pile.size())
	print(\"Info: Cards in discard pile - \", discard_pile.size())
	for i in range(count):
		# From discard to draw pile
		if draw_pile.is_empty():
			reshuffle_discard_into_draw()
		
		# If not enough cards
		if draw_pile.is_empty():
			break
		
		# Drawing card
		var card_data = draw_pile.pop_back()
		hand_pile.append(card_data)
		
		create_card_ui(card_data)

func reshuffle_discard_into_draw():
	print(\"Act: Draw pile is empty, reshuffling\")
	if discard_pile.is_empty():
		return
		
	draw_pile = discard_pile.duplicate()
	draw_pile.shuffle()
	discard_pile.clear()

func create_card_ui(data: CardData):
	var card_wrapper = Control.new()
	card_wrapper.custom_minimum_size = Vector2(130, 300)
	
	card_wrapper.name = \"Card_\" + data.resource_path.get_file().get_basename()
	
	var new_card = card_scene.instantiate()
	hand_container.add_child(card_wrapper)
	card_wrapper.add_child(new_card)
	new_card.setup(data)
	
	card_wrapper.mouse_filter = Control.MOUSE_FILTER_STOP
	card_wrapper.gui_input.connect(_on_wrapper_input.bind(new_card, data))

func _on_card_selected(card_node: Node2D, card_data: CardData):
	# Пытаемся добавить карту в очередь
	var success = try_to_queue_card(card_data, card_node)
	
	if success:
		# Визуальный эффект: например, сдвигаем карту чуть вверх 
		# или делаем полупрозрачной, показывая, что она \"выбрана\"
		card_node.position.y -= 50
		card_node.modulate = Color(0.7, 0.9, 1.0) # Слегка подсиним её

func check_target_under_mouse():
	var mouse_pos = hand_container.get_global_mouse_position()
	
	var space_state = dragged_card_node.get_world_2d().direct_space_state
	var query = PhysicsPointQueryParameters2D.new()
	query.position = mouse_pos
	query.collide_with_areas = true
	query.collide_with_bodies = false
	
	var results = space_state.intersect_point(query)
	var target_found = false
	
	for result in results:
		var area = result.collider as Area2D
		if area:
			var entity = area.get_parent() as Entity
			
			# Умная проверка на основе TargetType из самого ресурса карты!
			if dragged_card_data.target_type == CardData.TargetType.ENEMY and entity.is_in_group(\"enemies\"):
				confirm_card_selection(entity)
				target_found = true
				break
			elif dragged_card_data.target_type == CardData.TargetType.PLAYER and entity.is_in_group(\"players\"):
				confirm_card_selection(entity)
				target_found = true
				break
	
	if not target_found:
		return_card_to_hand()

func confirm_card_selection(target_entity: Entity):
	# Сохраняем в очередь и карту, и того, на кого её навели
	action_queue.append({
		\"card_data\": dragged_card_data,
		\"target\": target_entity
	})
	hand_pile.erase(dragged_card_data)
	
	dragged_card_node.position = original_card_position + Vector2(0, -60)
	dragged_card_node.modulate = Color(0.7, 0.9, 1.0)
	clear_drag_variables()

func return_card_to_hand():
	# Анимируем плавное возвращение карты на её законное место в руке
	var tween = create_tween()
	tween.tween_property(dragged_card_node, \"position\", original_card_position, 0.15).set_trans(Tween.TRANS_QUAD)
	clear_drag_variables()

func clear_drag_variables():
	dragged_card_node = null
	dragged_card_data = null

func _on_wrapper_input(event: InputEvent, card_node: Node2D, card_data: CardData):
	# 1. Нажатие мыши — начинаем тащить
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if event.pressed:
			# Проверяем, не полная ли очередь и подходят ли условия
			if action_queue.size() >= MAX_QUEUE_SIZE:
				return
			
			var already_in_queue = false
			for action in action_queue:
				if action[\"card_data\"] == card_data:
					already_in_queue = true
					break
			
			if not card_data.can_be_played(self):
				print(\"Нельзя сыграть эту карту!\")
				return
				
			dragged_card_node = card_node
			dragged_card_data = card_data
			original_card_position = card_node.position # Запоминаем исходное место в руке
			is_dragging = true
			
		# 2. Отпускание мыши — проверяем, куда навели
		elif not event.pressed and is_dragging:
			is_dragging = false
			check_target_under_mouse()

func _process(_delta):
	# Если мы тащим карту, заставляем её Node2D следовать за глобальным курсором
	if is_dragging and dragged_card_node:
		# Так как Node2D находится внутри Control, нам нужно перевести глобальные координаты мыши 
		# в локальные координаты родительского wrapper'а
		dragged_card_node.global_position = dragged_card_node.get_global_mouse_position()

func discard_hand():
	for child in hand_container.get_children():
		child.queue_free()
		
	discard_pile.append_array(hand_pile)
	discard_pile.append_array(action_queue)
	hand_pile.clear()
	action_queue.clear()
	print(\"Act: Cards discarded\")

func try_to_queue_card(card_data: CardData, card_node: Node2D) -> bool:
	if action_queue.size() >= MAX_QUEUE_SIZE:
		return false
	
	var already_in_queue = false
	for action in action_queue:
		if action[\"card_data\"] == card_data:
			already_in_queue = true
			break
	
	if not card_data.can_be_played(self):
		print(\"INFO: Card cant be played \", card_data.card_name, \" (Возможно, мало энергии)\")
		return false
	
	# Добавляем данные в очередь
	action_queue.append(card_data)
	
	# Удаляем карту из руки в коде, чтобы она не ушла в сброс дважды
	hand_pile.erase(card_data)
	
	print(\"Info: card added in position: \", action_queue.size(), \"/\", MAX_QUEUE_SIZE)
	return true

func _on_button_pressed() -> void:
	if not action_queue.is_empty():
		print(\"--- НАЧАЛО ОТЫГРЫША КАРТ ИГРОКА ---\")
		
		for action in action_queue:
			var card = action[\"card_data\"] as CardData
			var target = action[\"target\"] as Entity
			
			# Карта сама выполняет свои эффекты! 
			# В качестве того, кто разыграл (user), передаем нашего игрока.
			card.play(character_node, target)
			
		print(\"--- КОНЕЦ ОТЫГРЫША КАРТ ИГРОКА ---\")
	
	# NOT IMPLEMENTED
	#if enemy_node and enemy_node.current_hp > 0:
		#print(\"--- ХОД ВРАГА ---\")
		#enemy_node.take_turn(player_node)
	
	discard_hand()
	draw_cards(5)
"

